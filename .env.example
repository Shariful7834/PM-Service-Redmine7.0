# Copy to .env and fill secrets:  cp .env.example .env
# Generate secrets (PowerShell):
#   [guid]::NewGuid().ToString('N')                      -> DB_PASS
#   -join ((1..64)|%{'{0:x}'-f(Get-Random -Max 16)})     -> REDMINE_SECRET_KEY_BASE

# Redmine version — official image tag (base of the local dee-redmine build).
REDMINE_VERSION=7.0

# Host port for the web UI -> http://localhost:3000 (official image listens on 3000)
REDMINE_PORT=3000

TZ=Europe/Berlin

# Database (shared by the postgres service and Redmine)
DB_NAME=redmine_production
DB_USER=redmine
DB_PASS=change-me

# Rails secret (64 hex chars). REQUIRED. Never commit the real value.
REDMINE_SECRET_KEY_BASE=change-me

# --- Keycloak (local OAuth/OIDC proof-of-concept) ---
# Host port for Keycloak. 8080 is often taken (XAMPP/Apache) -> use 8088.
# The Redmine OAuth "Site" must be http://host.docker.internal:<this port>.
KEYCLOAK_PORT=8088
KEYCLOAK_ADMIN=admin
KEYCLOAK_ADMIN_PASSWORD=change-me
# redmine_oauth <-> Keycloak client secret (realm 'd-lab', client 'redmine').
# After changing this, re-render the realm import:
#   envsubst < keycloak/d-lab-realm.template.json > keycloak/import/d-lab-realm.json
REDMINE_OAUTH_CLIENT_SECRET=change-me
# demo login for the Redmine SSO test (username: testuser / testuser@example.com)
# Set your own value, then re-render the realm import (command above).
KEYCLOAK_TEST_USER_PASSWORD=change-me
