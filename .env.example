# Copy to .env and fill in real values — or just run ./scripts/setup.sh, which
# generates this file with freshly created secrets.
#
# NEVER commit .env. Generate secrets with:  openssl rand -hex 32

# ------------------------------------------------- development vs. server
# These two lines add the local Keycloak identity provider to every
# `docker compose` command. On a SERVER, delete both lines — then only Redmine
# and PostgreSQL start, and the demo identity provider can never run there.
COMPOSE_PATH_SEPARATOR=;
COMPOSE_FILE=docker-compose.yml;docker-compose.dev.yml

# ---------------------------------------------------------------- Redmine
# Official image tag used as the base of the local dee-redmine build.
REDMINE_VERSION=7.0
# Host port for the web UI -> http://localhost:3000
REDMINE_PORT=3000
# Which interface the port is published on. Leave as-is locally.
# On a SERVER set 127.0.0.1 so only the reverse proxy can reach Redmine.
REDMINE_BIND=0.0.0.0
TZ=Europe/Berlin

# Rails secret (64 hex chars). REQUIRED.
REDMINE_SECRET_KEY_BASE=change-me

# --------------------------------------------------------------- Database
DB_NAME=redmine_production
DB_USER=redmine
DB_PASS=change-me

# ------------------------------- Keycloak (local development IdP only)
# Not deployed on the server — there the real DEE user service is used.
# Port 8080 is often taken (XAMPP/Apache), hence 8088.
KEYCLOAK_PORT=8088
KEYCLOAK_ADMIN=admin
KEYCLOAK_ADMIN_PASSWORD=change-me

# OAuth client secrets for the two demo realms (d-lab = DEE, idial = IDiAL).
# After changing these, re-render the realm imports:  ./scripts/setup.sh
REDMINE_OAUTH_CLIENT_SECRET=change-me
IDIAL_CLIENT_SECRET=change-me

# Demo users created inside the realms (development only).
KEYCLOAK_TEST_USER_PASSWORD=change-me
IDIAL_TEST_USER_PASSWORD=change-me
