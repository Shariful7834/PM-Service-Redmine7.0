{
  "realm": "idial",
  "enabled": true,
  "sslRequired": "none",
  "registrationAllowed": false,
  "loginWithEmailAllowed": true,
  "clients": [
    {
      "clientId": "redmine",
      "name": "Redmine",
      "enabled": true,
      "protocol": "openid-connect",
      "publicClient": false,
      "secret": "${IDIAL_CLIENT_SECRET}",
      "standardFlowEnabled": true,
      "directAccessGrantsEnabled": true,
      "redirectUris": [
        "http://localhost:${REDMINE_PORT}/oauth2callback",
        "http://host.docker.internal:${REDMINE_PORT}/oauth2callback"
      ],
      "webOrigins": ["+"],
      "attributes": {
        "post.logout.redirect.uris": "+"
      }
    }
  ],
  "users": [
    {
      "username": "idialuser",
      "enabled": true,
      "emailVerified": true,
      "email": "idial.user@idial.example.com",
      "firstName": "Idial",
      "lastName": "Person",
      "credentials": [
        {
          "type": "password",
          "value": "${IDIAL_TEST_USER_PASSWORD}",
          "temporary": false
        }
      ]
    }
  ]
}
